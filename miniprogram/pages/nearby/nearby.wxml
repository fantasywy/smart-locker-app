<!--
  附近柜机 —— 只读站点目录（ticket #72 / spec #57 §8）。

  ⚠️ 本文件没有一句用户可见字面量：标题 / 搜索 / 定位横幅 / 列表头 / 四类空态 /
     城市选择器全部来自 startup/copy.ts，页面 data 只做转手。
  ⚠️ 四类空态互不混淆：
       empty     → 附近 3 km 没有柜机（扩大到 10 km / 切换城市）
       noresult  → 搜索无结果（保留搜索词）
       neterr    → 网络失败（暂时连不上 / 重试）
       denied    → 未定位横幅，不是空页；列表仍可用
  ⚠️ 没有地图 / 列表切换，没有「查看柜机」「下单」「预约」出口。
  ⚠️ 地图带与列表共用 selectedSiteId；全屏地图是同页的次级状态，不是新页面。
     全屏卡片浮层用 cover-view —— 原生 <map> 会盖住普通 view。
-->
<navigation-bar title="{{ title }}" back="{{false}}" />

<view class="page">
  <!-- 搜索区：城市永远在搜索框里；提交后才搜。 -->
  <view wx:if="{{ city }}" class="nearby__search">
    <view
      class="nearby__city"
      bindtap="onOpenCityPicker"
      hover-class="nearby__city_active"
      hover-start-time="0"
      hover-stay-time="0"
      aria-role="button"
    >
      <text class="nearby__city-name">{{ city }}</text>
      <icon name="nav.disclosure" tone="weak" size="{{14}}" />
    </view>

    <view class="nearby__search-box">
      <icon name="action.search" tone="weak" size="{{16}}" />
      <input
        class="nearby__input"
        value="{{ keywordDraft }}"
        placeholder="{{ searchPlaceholder }}"
        confirm-type="search"
        bindinput="onKeywordInput"
        bindconfirm="onSearch"
      />
      <view
        wx:if="{{ showClear }}"
        class="nearby__clear"
        bindtap="onClearSearch"
        aria-role="button"
        aria-label="{{ clearSearchLabel }}"
      >
        <icon name="action.close" tone="weak" size="{{14}}" />
      </view>
      <view
        class="nearby__search-action"
        bindtap="onSearch"
        hover-class="nearby__search-action_active"
        hover-start-time="0"
        hover-stay-time="0"
        aria-role="button"
      >{{ searchAction }}</view>
    </view>
  </view>
  <view wx:if="{{ city }}" class="nearby__search-hint">{{ searchHint }}</view>

  <!-- 未定位横幅：拒绝 / 类目未批 / 系统不可用都落在这里；列表与搜索照常。 -->
  <view
    wx:if="{{ showLocationBanner && city }}"
    class="nearby__location"
  >
    <view class="nearby__location-text">{{ locationBanner }}</view>
    <view
      class="nearby__location-action"
      bindtap="onLocate"
      hover-class="nearby__location-action_active"
      hover-start-time="0"
      hover-stay-time="0"
      aria-role="button"
    >{{ locationAction }}</view>
  </view>

  <!--
    地图带（206px）：搜索区之下、列表之上，无「地图 / 列表」切换。
    - marker 只落有坐标站点；callout 只挂选中 marker（同屏一个）。
    - 失败后塌成 64px 提示行，列表原样保留；重试只重挂地图。
  -->
  <view
    wx:if="{{ showMapBand }}"
    class="nearby__map-band {{ mapFailed ? 'is-failed' : '' }}"
  >
    <map
      wx:if="{{ !mapFailed }}"
      id="nearby-map"
      class="nearby__map"
      latitude="{{ mapLatitude }}"
      longitude="{{ mapLongitude }}"
      scale="{{ mapScale }}"
      markers="{{ markers }}"
      bindmarkertap="onMarkerTap"
      bindregionchange="onRegionChange"
      bindupdated="onMapUpdated"
      bindrendererror="onMapRenderError"
    >
      <cover-view
        class="nearby__map-entry"
        bindtap="onOpenFullscreen"
      >{{ mapFullscreenLabel }}</cover-view>
    </map>

    <view wx:if="{{ mapFailed }}" class="nearby__map-fail">
      <view class="nearby__map-fail-text">
        <view class="nearby__map-fail-title">{{ mapFailTitle }}</view>
        <view class="nearby__map-fail-hint">{{ mapFailHint }}</view>
      </view>
      <view
        class="nearby__map-fail-action"
        bindtap="onMapRetry"
        hover-class="nearby__map-fail-action_active"
        hover-start-time="0"
        hover-stay-time="0"
        aria-role="button"
      >{{ retryLabel }}</view>
    </view>
  </view>

  <!-- 首屏骨架：三张站点卡，纯图形、无文字。 -->
  <skeleton wx:if="{{ phase === 'loading' }}" variant="nearby" />

  <!-- 首次无城市：城市选择器铺在底部，站点列表不发请求。 -->
  <view wx:elif="{{ phase === 'citypick' }}" class="nearby__citypick-hold"></view>

  <!-- 网络失败：页内重试块，tabBar 仍可用。 -->
  <view wx:elif="{{ phase === 'neterr' }}" class="nearby__failed">
    <view class="nearby__failed-title">{{ networkTitle }}</view>
    <view class="nearby__failed-detail">{{ networkDetail }}</view>
    <button
      class="nearby__failed-action"
      hover-class="nearby__failed-action_active"
      bindtap="onRetry"
    >{{ retryLabel }}</button>
  </view>

  <!-- 附近无柜机：与搜索无结果分开；扩半径与换城市两个出口。 -->
  <block wx:elif="{{ phase === 'empty' }}">
    <empty-state
      title="{{ emptyTitle }}"
      hint="{{ emptyHint }}"
      action-label="{{ emptyActionLabel }}"
      bind:action="onExpandRadius"
    />
    <view
      class="nearby__switch-city"
      bindtap="onOpenCityPicker"
      hover-class="nearby__switch-city_active"
      hover-start-time="0"
      hover-stay-time="0"
      aria-role="button"
    >{{ switchCityLabel }}</view>
  </block>

  <!-- 搜索无结果：保留关键词，提示换词 / 换城市。 -->
  <block wx:elif="{{ phase === 'noresult' }}">
    <empty-state title="{{ noResultTitle }}" hint="{{ noResultHint }}" />
    <view
      class="nearby__switch-city"
      bindtap="onOpenCityPicker"
      hover-class="nearby__switch-city_active"
      hover-start-time="0"
      hover-stay-time="0"
      aria-role="button"
    >{{ switchCityLabel }}</view>
  </block>

  <!-- 站点列表：服务端顺序原样渲染；卡片唯一动作是导航。 -->
  <view wx:elif="{{ phase === 'ready' }}" class="nearby__list">
    <view class="nearby__list-header">{{ listHeader }}</view>
    <view class="nearby__cards">
      <view
        wx:for="{{ sites }}"
        wx:key="siteId"
        id="nearby-site-{{ item.siteId }}"
        class="nearby__card {{ item.siteId === selectedSiteId ? 'is-selected' : '' }}"
      >
        <station-card
          site="{{ item }}"
          bind:select="onSiteSelect"
          bind:navigate="onSiteNavigate"
        />
      </view>
    </view>
  </view>

  <van-toast id="van-toast" />
</view>

<!-- 城市选择器 —— 数据来自 GET /nearby/cities；首次无城市时不可关闭。 -->
<view wx:if="{{ showCityPicker }}" class="nearby__overlay">
  <view class="nearby__sheet">
    <view class="nearby__sheet-title">{{ cityPickerTitle }}</view>
    <scroll-view scroll-y class="nearby__city-list">
      <view
        wx:for="{{ cities }}"
        wx:key="*this"
        class="nearby__city-option {{ item === city ? 'is-selected' : '' }}"
        data-city="{{ item }}"
        bindtap="onCitySelect"
      >{{ item }}</view>
    </scroll-view>
    <view
      wx:if="{{ cityPickerDismissable }}"
      class="nearby__sheet-cancel"
      bindtap="onCityPickerClose"
      hover-class="nearby__sheet-cancel_active"
      hover-start-time="0"
      hover-stay-time="0"
      aria-role="button"
    >{{ cityPickerCancel }}</view>
  </view>
</view>

<!--
  全屏地图 —— 同一页的次级入口（`showFullscreenMap`），不新增路由。
  ⚠️ 卡片浮层与返回按钮都在 <map> 内、且只能用 cover-view / cover-image：
     原生地图层级高于普通 view，普通浮层会被盖住。
-->
<view wx:if="{{ showFullscreenMap }}" class="nearby__fullscreen">
  <map
    id="nearby-fullscreen-map"
    class="nearby__fs-map"
    latitude="{{ mapLatitude }}"
    longitude="{{ mapLongitude }}"
    scale="{{ mapScale }}"
    markers="{{ markers }}"
    bindmarkertap="onMarkerTap"
    bindregionchange="onRegionChange"
    bindupdated="onMapUpdated"
    bindrendererror="onMapRenderError"
  >
    <cover-view class="nearby__fs-exit" bindtap="onCloseFullscreen">{{ mapExitLabel }}</cover-view>

    <cover-view wx:if="{{ selectedCard.siteId }}" class="nearby__fs-card">
      <cover-view class="nearby__fs-head">
        <cover-view class="nearby__fs-name">{{ selectedCard.name }}</cover-view>
        <cover-view
          wx:if="{{ selectedCard.statusLabel }}"
          class="nearby__fs-status is-{{ selectedCard.statusTone }}"
        >{{ selectedCard.statusLabel }}</cover-view>
      </cover-view>
      <cover-view wx:if="{{ selectedCard.showDistance }}" class="nearby__fs-distance">{{ selectedCard.distanceText }}</cover-view>
      <cover-view wx:if="{{ selectedCard.showAddress }}" class="nearby__fs-address">{{ selectedCard.address }}</cover-view>
      <cover-view class="nearby__fs-footer">{{ selectedCard.footer }}</cover-view>
      <cover-view
        wx:if="{{ selectedCard.showNavigate }}"
        class="nearby__fs-navigate"
        bindtap="onFullscreenNavigate"
      >{{ selectedCard.navigateLabel }}</cover-view>
    </cover-view>
  </map>
</view>
