<!--
  预约创建页（结构级）—— spec #57 §10 / 契约 13.12。

  ⚠️ **本文件没有一句用户可见字面量**：分组标题 / 档位 / 日期 / 时长 / 提交与
  校验提示全部来自 `startup/copy.ts` 与 `LOCKER_PAGE_COPY.cellTypeLabels`。

  ⚠️ **没有金额输入、也没有金额展示**：`13.12` 没有价格字段，费用在取件时结算。
     任何人想在这里加「预计价格」之前，先去看契约 —— 客户端编不出一个服务端会认的价。

  ⚠️ 表单只让用户选「开始档位 + 时长」，`planEndAt` 由页面相加得出。
     档位只渲染未来；今天的档位用完后指路到明天。
-->
<navigation-bar title="{{ title }}" back="{{true}}" />

<view class="page">
  <!-- 没有 lockerId：预约创建只能从柜机页扫码进入。 -->
  <view wx:if="{{ invalidEntry }}" class="reservation-create__invalid">
    <view class="reservation-create__invalid-detail">{{ entryHint }}</view>
  </view>

  <block wx:else>
    <!-- ① 格口档位 —— 数字码 1–4 的中文名来自柜机页同一张表。 -->
    <view class="reservation-create__section">
      <view class="reservation-create__label">{{ cellTypeSection }}</view>
      <view class="reservation-create__options">
        <view
          wx:for="{{ cellTypeOptions }}"
          wx:key="value"
          class="reservation-create__chip {{ selectedCellType === item.value ? 'is-selected' : '' }}"
          hover-class="reservation-create__chip_active"
          hover-start-time="0"
          hover-stay-time="0"
          data-value="{{ item.value }}"
          bindtap="onSelectCellType"
          aria-role="button"
        >{{ item.label }}</view>
      </view>
    </view>

    <!-- ② 开始时间 —— 今天 / 明天 + 30 分钟档位。 -->
    <view class="reservation-create__section">
      <view class="reservation-create__label">{{ startSection }}</view>
      <view class="reservation-create__options">
        <view
          wx:for="{{ dateOptions }}"
          wx:key="value"
          class="reservation-create__chip {{ selectedDate === item.value ? 'is-selected' : '' }}"
          hover-class="reservation-create__chip_active"
          hover-start-time="0"
          hover-stay-time="0"
          data-value="{{ item.value }}"
          bindtap="onSelectDate"
          aria-role="button"
        >{{ item.label }}</view>
      </view>
      <view class="reservation-create__options reservation-create__options--slots">
        <view
          wx:for="{{ slotOptions }}"
          wx:key="value"
          class="reservation-create__chip reservation-create__chip--slot {{ selectedSlot === item.value ? 'is-selected' : '' }}"
          hover-class="reservation-create__chip_active"
          hover-start-time="0"
          hover-stay-time="0"
          data-value="{{ item.value }}"
          bindtap="onSelectSlot"
          aria-role="button"
        >{{ item.label }}</view>
      </view>
      <view wx:if="{{ showEmptySlotHint }}" class="reservation-create__hint">{{ emptySlotHint }}</view>
    </view>

    <!-- ③ 使用时长 —— 1 / 2 / 4 / 8 小时。 -->
    <view class="reservation-create__section">
      <view class="reservation-create__label">{{ durationSection }}</view>
      <view class="reservation-create__options">
        <view
          wx:for="{{ durationOptions }}"
          wx:key="hours"
          class="reservation-create__chip {{ selectedHours === item.hours ? 'is-selected' : '' }}"
          hover-class="reservation-create__chip_active"
          hover-start-time="0"
          hover-stay-time="0"
          data-value="{{ item.hours }}"
          bindtap="onSelectDuration"
          aria-role="button"
        >{{ item.label }}</view>
      </view>
    </view>

    <!-- ④ 动作点：失败就地解释，不弹 toast、不清选择。 -->
    <view wx:if="{{ submitError }}" class="reservation-create__error">{{ submitError }}</view>
    <button
      class="reservation-create__submit"
      hover-class="reservation-create__submit_active"
      hover-start-time="0"
      hover-stay-time="0"
      disabled="{{ submitting }}"
      bindtap="onSubmit"
    >{{ submitting ? submittingLabel : submitLabel }}</button>
  </block>
</view>
