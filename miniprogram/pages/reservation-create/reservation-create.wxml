<!--
  预约创建页（结构级）—— spec #57 §10 / 契约 13.12。

  ⚠️ **本文件没有一句用户可见字面量**：分组标题 / 档位 / 日期 / 占位符 / 提交与
  校验提示全部来自 `startup/copy.ts` 与 `LOCKER_PAGE_COPY.cellTypeLabels`。

  ⚠️ **没有金额输入、也没有金额展示**：`13.12` 没有价格字段，费用在取件时结算。
     任何人想在这里加「预计价格」之前，先去看契约 —— 客户端编不出一个服务端会认的价。

  ⚠️ 表单只让用户给出契约里的两个时刻：**开始时间**与**结束时间**，用原生
     `<picker mode="time">`（平台自带的时间选择器）。页面不自造档位表 ——
     早先的「30 分钟档位 + 1/2/4/8 小时时长」不在 `13.12` 里，已删除。
-->
<navigation-bar title="{{ title }}" back="{{true}}" />

<view class="page">
  <!-- 没有 lockerId：预约创建只能从柜机页扫码进入。 -->
  <view wx:if="{{ invalidEntry }}" class="reservation-create__invalid">
    <view class="reservation-create__invalid-detail">{{ entryHint }}</view>
  </view>

  <block wx:else>
    <!-- ① 格口档位 —— 数字码 1–4 的中文名来自柜机页同一张表。 -->
    <view class="reservation-create__section">
      <view class="reservation-create__label">{{ cellTypeSection }}</view>
      <view class="reservation-create__options">
        <view
          wx:for="{{ cellTypeOptions }}"
          wx:key="value"
          class="reservation-create__chip {{ selectedCellType === item.value ? 'is-selected' : '' }}"
          hover-class="reservation-create__chip_active"
          hover-start-time="0"
          hover-stay-time="0"
          data-value="{{ item.value }}"
          bindtap="onSelectCellType"
          aria-role="button"
        >{{ item.label }}</view>
      </view>
    </view>

    <!-- ② 日期上下文 —— 今天 / 明天；两个时刻本身与日期无关。 -->
    <view class="reservation-create__section">
      <view class="reservation-create__label">{{ startSection }}</view>
      <view class="reservation-create__options">
        <view
          wx:for="{{ dateOptions }}"
          wx:key="value"
          class="reservation-create__chip {{ selectedDate === item.value ? 'is-selected' : '' }}"
          hover-class="reservation-create__chip_active"
          hover-start-time="0"
          hover-stay-time="0"
          data-value="{{ item.value }}"
          bindtap="onSelectDate"
          aria-role="button"
        >{{ item.label }}</view>
      </view>
    </view>

    <!-- ③ 开始 / 结束时间 —— 原生时间选择器；`value` 为空时显示占位符。 -->
    <view class="reservation-create__section">
      <view class="reservation-create__row">
        <picker
          mode="time"
          class="reservation-create__picker"
          value="{{ startTime }}"
          bindchange="onPickStart"
        >
          <view class="reservation-create__field">
            <text class="reservation-create__field-label">{{ startSection }}</text>
            <text class="reservation-create__field-value {{ startTime === '' ? 'is-placeholder' : '' }}">{{ startTime === '' ? pickTime : startTime }}</text>
          </view>
        </picker>
        <picker
          mode="time"
          class="reservation-create__picker"
          value="{{ endTime }}"
          bindchange="onPickEnd"
        >
          <view class="reservation-create__field">
            <text class="reservation-create__field-label">{{ endSection }}</text>
            <text class="reservation-create__field-value {{ endTime === '' ? 'is-placeholder' : '' }}">{{ endTime === '' ? pickTime : endTime }}</text>
          </view>
        </picker>
      </view>
    </view>

    <!-- ④ 动作点：失败就地解释，不弹 toast、不清选择。 -->
    <view wx:if="{{ submitError }}" class="reservation-create__error">{{ submitError }}</view>
    <button
      class="reservation-create__submit"
      hover-class="reservation-create__submit_active"
      hover-start-time="0"
      hover-stay-time="0"
      disabled="{{ submitting }}"
      bindtap="onSubmit"
    >{{ submitting ? submittingLabel : submitLabel }}</button>
  </block>
</view>
