<!--
  信用分明细页 —— 每行只有：变动值（带符号）/ 原因 / 时间（spec #57 §10）。

  ⚠️ **本文件没有一句用户可见字面量**：标题 / 失败句 / 空态标题全部来自
     `startup/copy.ts`，页面 data 只是转手。
  ⚠️ **不画内部字段**：`type`（AUTO / MANUAL）、`operatorName`（员工名）
     与当前分数都不在渲染模型里，模板也就没有可插值的地方。
  ⚠️ 二级页：导航栏显示返回箭头（从「我的」进来）。
-->
<navigation-bar title="{{ title }}" back="{{true}}" />

<view class="page">
  <!-- 首屏骨架：与列表行同构；静态、无文字，数据回来后直接替换。 -->
  <skeleton wx:if="{{ phase === 'loading' }}" />

  <!-- 页内失败：不甩成全局失败出口（那一个只给登录链）。 -->
  <view wx:elif="{{ phase === 'failed' }}" class="score-logs__failed">
    <view class="score-logs__failed-detail">{{ loadFailed }}</view>
    <button
      class="score-logs__failed-action"
      hover-class="score-logs__failed-action_active"
      bindtap="onRetry"
    >{{ retryLabel }}</button>
  </view>

  <!-- 空态只有标题：不传 hint / action-label，不编说明与按钮。 -->
  <empty-state wx:elif="{{ isEmpty }}" title="{{ emptyTitle }}" />

  <view wx:else class="score-logs__list">
    <view wx:for="{{ logs }}" wx:key="id" class="score-logs__row">
      <view class="score-logs__copy">
        <view class="score-logs__reason">{{ item.reason }}</view>
        <view class="score-logs__time">{{ item.time }}</view>
      </view>
      <view class="score-logs__delta is-{{ item.deltaTone }}">{{ item.deltaText }}</view>
    </view>
  </view>

  <!-- 反馈宿主：页面决定宿主在哪，页面本身不 import Vant 的 Toast / Dialog。 -->
  <van-toast id="van-toast" />
</view>
