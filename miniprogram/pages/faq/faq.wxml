<!--
  常见问题页 —— 正文由内容端点下发，界面只按三种 block 排版。

  ⚠️ **本文件里没有一句问题 / 答案，也没有一句界面文案字面量**：
     标题 / 失败提示 / 重试按钮来自 `startup/copy.ts`，问答正文来自 `GET /contents/faq`。
     七个必答主题（存件 / 取件与取件码 / 费用与支付时机 / 超时 / 预约与爽约失效 /
     柜门打不开 / 柜机故障）由后端内容维护，客户端不写死。

  ⚠️ 三个相位互斥：骨架 → 内容直接替换；失败停在页内失败态，不停在骨架屏上。
-->
<navigation-bar title="{{ title }}" back="{{ true }}"></navigation-bar>

<view class="page">
  <!-- ① 加载骨架 —— 纯图形占位，无文字。 -->
  <skeleton wx:if="{{ phase === 'loading' }}" variant="list" />

  <!-- ② 页内失败 —— 未知 key / 网络失败都落这里，不白屏。 -->
  <view wx:elif="{{ phase === 'loadFailed' }}" class="content-failed">
    <view class="content-failed__detail">{{ loadFailedDetail }}</view>
    <button
      class="content-failed__retry"
      hover-class="content-failed__retry_active"
      bindtap="onRetryLoad"
    >{{ retryLabel }}</button>
  </view>

  <!-- ③ 内容 —— 服务端给什么顺序就按什么顺序排。 -->
  <view wx:else class="content">
    <block wx:for="{{ blocks }}" wx:key="key">
      <view wx:if="{{ item.type === 'heading' }}" class="content__heading">{{ item.text }}</view>
      <view wx:elif="{{ item.type === 'paragraph' }}" class="content__paragraph">{{ item.text }}</view>
      <view wx:elif="{{ item.type === 'qa' }}" class="content__qa">
        <view class="content__question">{{ item.question }}</view>
        <view class="content__answer">{{ item.answer }}</view>
      </view>
    </block>
  </view>
</view>
