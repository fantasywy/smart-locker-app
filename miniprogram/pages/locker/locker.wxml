<!--
  柜机页 —— 扫码落地页（四档）。

  ⚠️ **本文件里没有一句文案字面量。** 用户可见的每个字都从 `startup/copy.ts`
     的 `LOCKER_PAGE_COPY` 来，页面的 `data` 只是把它转手。
  ⚠️ 四个相位由 `phase` 一个变量驱动：
       loading      → 站点 + 四张卡的骨架（纯图形，无文字）
       entryFailed  → 入口失效页（解析不出 code / 13.6 → 1002，只换文案）
       loadFailed   → 页内「加载失败，请重试」+ 重试
       ready        → 站点信息 + 2×2 四档 + 预约入口 + 事实行 + 吸底行动条
  ⚠️ ready 里没有「错误」这一支 —— 柜机离线与四档全满是正常响应，
     靠 `cells[].state` / `reserveEnabled` 置灰 + 页内原因呈现。
-->
<navigation-bar
  title="{{ title }}"
  back="{{ navBack }}"
  homeButton="{{ navHome }}"
  ordersButton="{{ navOrders }}"
></navigation-bar>

<view class="page">
  <view class="page__body">
    <!-- ① 加载骨架 —— 结构先出现，数据区等 13.6。无文字。 -->
    <view wx:if="{{ phase === 'loading' }}" class="locker-loading">
      <view class="locker-loading__header"></view>
      <view class="locker-loading__grid">
        <view class="locker-loading__card" wx:for="{{ loadingCards }}" wx:key="*this"></view>
      </view>
    </view>

    <!--
      ② 入口失效页 —— 解析不出 code 与 13.6 → 1002 共用这一支，
         只换标题 / 说明句。两个出口：重新扫码 / 我的订单。
    -->
    <view wx:elif="{{ phase === 'entryFailed' }}" class="entry-failed">
      <view class="entry-failed__title">{{ entryFailedTitle }}</view>
      <view class="entry-failed__detail">{{ entryFailedDetail }}</view>
      <view class="entry-failed__actions">
        <button
          class="entry-failed__primary"
          hover-class="entry-failed__primary_active"
          bindtap="onRescan"
        >{{ rescanLabel }}</button>
        <button
          class="entry-failed__secondary"
          hover-class="entry-failed__secondary_active"
          bindtap="onMyOrders"
        >{{ myOrdersLabel }}</button>
      </view>
    </view>

    <!-- ②b 加载失败 —— 请求已经回来且失败了，绝不能停在骨架屏。 -->
    <view wx:elif="{{ phase === 'loadFailed' }}" class="entry-failed">
      <view class="entry-failed__title"></view>
      <view class="entry-failed__detail">{{ loadFailedDetail }}</view>
      <view class="entry-failed__actions">
        <button
          class="entry-failed__primary"
          hover-class="entry-failed__primary_active"
          bindtap="onRetryLoad"
        >{{ retryLabel }}</button>
      </view>
    </view>

    <!-- ③ 正常响应（含离线与四档全满）。 -->
    <view wx:else class="locker">
      <view class="locker__header">
        <view class="locker__title-row">
          <view class="locker__site">{{ siteName }}</view>
          <text wx:if="{{ !lockerUsable }}" class="locker__pill">{{ offlinePill }}</text>
        </view>
        <view class="locker__position">{{ position }}</view>
        <view wx:if="{{ lockerReason }}" class="locker__reason">{{ lockerReason }}</view>
      </view>

      <!-- 2×2 四档，顺序固定小 / 中 / 大 / 特大（数组顺序 = 视觉顺序）。 -->
      <view class="locker__cells">
        <view class="locker__cell" wx:for="{{ cells }}" wx:key="type">
          <cell-card
            class="locker__cell-card"
            type="{{ item.type }}"
            label="{{ item.label }}"
            available="{{ item.available }}"
            state="{{ item.state }}"
            selected="{{ item.selected }}"
            bind:select="onSelectCell"
          />
        </view>
      </view>

      <!-- 预约入口：只在离线 / 四档全满时置灰并写明原因。 -->
      <view class="locker__reserve-row">
        <view
          class="locker__reserve {{ reserveEnabled ? '' : 'is-disabled' }}"
          hover-class="{{ reserveEnabled ? 'locker__reserve_active' : 'none' }}"
          aria-role="button"
          aria-label="{{ reserveLabel }}"
          bindtap="onReserve"
        >
          <text class="locker__reserve-label">{{ reserveLabel }}</text>
          <icon name="nav.disclosure" tone="{{ reserveEnabled ? 'sub' : 'weak' }}" size="16" />
        </view>
        <view wx:if="{{ reserveReason }}" class="locker__reserve-reason">{{ reserveReason }}</view>
      </view>

      <!-- 两条事实行。 -->
      <view class="locker__facts">
        <view class="locker__fact">{{ factCellAssigned }}</view>
        <view class="locker__fact">{{ factPaymentLater }}</view>
      </view>
    </view>
  </view>

  <!-- 提交失败 —— 底栏上方一行，就地解释，不弹 toast / modal。 -->
  <view wx:if="{{ submitError }}" class="locker__submit-error">{{ submitError }}</view>

  <!--
    吸底行动条 —— 入口失效页不渲染（那一屏只有两个出口）。
    未选中：请选择格口 / 四档均可存，CTA 置灰；
    选中：已选 {档名} / 余 N 个，CTA 可点。
    ⚠️ 任何状态都不出现金额。
  -->
  <view wx:if="{{ phase !== 'entryFailed' }}" class="locker__bar">
    <view class="locker__bar-text">
      <view class="locker__bar-title">{{ barTitle }}</view>
      <view class="locker__bar-hint">{{ barHint }}</view>
    </view>
    <van-button
      custom-class="locker__cta"
      type="primary"
      loading="{{ ctaLoading }}"
      loading-text="{{ ctaLabel }}"
      disabled="{{ !ctaEnabled && !ctaLoading }}"
      bind:click="onPrimary"
    >{{ ctaLabel }}</van-button>
  </view>

  <!--
    确认弹层 —— 站点 / 档位 / 余位三行 + 取消 / 确认存件。
    ⚠️ 提交中 `confirmOverlayClosable=false`，遮罩不可关；取消按钮也禁用。
  -->
  <van-popup
    show="{{ confirmVisible }}"
    position="bottom"
    round="{{ true }}"
    custom-class="app-popup-shadow locker-sheet"
    close-on-click-overlay="{{ confirmOverlayClosable }}"
    bind:click-overlay="onCancelSheet"
  >
    <view class="locker-sheet__title">{{ confirmTitle }}</view>
    <view class="locker-sheet__row">
      <text class="locker-sheet__label">{{ confirmSiteLabel }}</text>
      <text class="locker-sheet__value">{{ confirmSiteName }}</text>
    </view>
    <view class="locker-sheet__row">
      <text class="locker-sheet__label">{{ confirmCellLabel }}</text>
      <text class="locker-sheet__value">{{ confirmCellValue }}</text>
    </view>
    <view class="locker-sheet__row">
      <text class="locker-sheet__label">{{ confirmRemainingLabel }}</text>
      <text class="locker-sheet__value">{{ confirmRemainingValue }}</text>
    </view>
    <view class="locker-sheet__actions">
      <van-button
        custom-class="locker-sheet__cancel"
        disabled="{{ submitting }}"
        bind:click="onCancelSheet"
      >{{ cancelLabel }}</van-button>
      <van-button
        custom-class="locker-sheet__confirm"
        type="primary"
        loading="{{ submitting }}"
        loading-text="{{ ctaLabel }}"
        disabled="{{ submitting }}"
        bind:click="onConfirmCreate"
      >{{ confirmActionLabel }}</van-button>
    </view>
  </van-popup>
</view>
